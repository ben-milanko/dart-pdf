.dart_tool/
build/
coverage/
doc/api/
.fvm/
.idea/
*.iml

# local test corpus of real-world PDFs (never committed)
corpus/
output/

# generated benchmark JSON + comparison tables (benchmark/run.sh)
benchmark/out/

# render-regression failure dumps (ghent_render_test.dart)
test_corpora/ghent/_failures/

# generated Ghent visual review gallery
test_corpora/ghent/_renders/

# generated by npm install for the PDF.js baseline renderer
packages/dart_pdf_editor/tool/pdfjs_baseline/node_modules/
packages/dart_pdf_editor/tool/pdfjs_baseline/package-lock.json

# Generated web render worker bundles (`dart compile js` output of
# `dart run dart_pdf_editor:build_web_worker`). NOT committed - regenerated at
# the three points that consume it: pub publish (tool/release.sh, with the
# assets package .pubignore re-including it in the archive), the web deploy /
# preview / release workflows, and local web builds (app/tool/build_web.sh).
# See issue #582 and doc/render_worker_web.md.
packages/dart_pdf_editor/assets/web/pdf_render_worker.dart.js
packages/dart_pdf_editor/assets/web/pdf_render_worker.dart.js.map
packages/dart_pdf_editor/assets/web/pdf_render_worker.dart.js.deps
packages/dart_pdf_editor_assets/assets/web/pdf_render_worker.dart.js
packages/dart_pdf_editor_assets/assets/web/pdf_render_worker.dart.js.map
packages/dart_pdf_editor_assets/assets/web/pdf_render_worker.dart.js.deps

# generated by flutter pub get for plugin-using packages
.flutter-plugins-dependencies
.DS_Store

# generated by Firebase Hosting
site/.firebase/hosting..cache

# perf tooling artifacts (tool/perf.sh)
tool/perf/history/
tool/perf/cache/

# Store screenshots. The standalone-app marketing tree (doc/marketing/app/,
# English + localized) IS tracked so AppStream metainfo can reference stable
# raw-URL screenshots. The example/SDK showcase localized subdirs and the
# staged store copies are regenerable (screenshots.sh compose from the tracked
# raw captures + captions), so they stay out.
doc/marketing/example/*/*/
app/fastlane/metadata/*/*/images/
