.dart_tool/
build/
coverage/
doc/api/
.fvm/
.idea/
*.iml

# local test corpus of real-world PDFs (never committed)
corpus/
output/

# generated benchmark JSON + comparison tables (benchmark/run.sh)
benchmark/out/

# render-regression failure dumps (ghent_render_test.dart)
test_corpora/ghent/_failures/

# generated Ghent visual review gallery
test_corpora/ghent/_renders/

# generated by npm install for the PDF.js baseline renderer
packages/dart_pdf_editor/tool/pdfjs_baseline/node_modules/
packages/dart_pdf_editor/tool/pdfjs_baseline/package-lock.json

# Build siblings of the web render worker (`dart compile js` output of
# `dart run dart_pdf_editor:build_web_worker`). The `.js.deps` in particular
# leaked absolute local pub-cache paths, and the `.js.map` is a large generated
# artifact - neither is ever committed. The `.js` itself is NOT ignored: a small
# stable placeholder is committed so the DECLARED Flutter asset always exists
# (analyze + every native/web build need it), and the real ~1 MB bundle is
# regenerated over it at publish/deploy/local-web-build, never committed. See
# issue #582 and doc/render_worker_web.md.
packages/dart_pdf_editor/assets/web/pdf_render_worker.dart.js.map
packages/dart_pdf_editor/assets/web/pdf_render_worker.dart.js.deps
packages/dart_pdf_editor_assets/assets/web/pdf_render_worker.dart.js.map
packages/dart_pdf_editor_assets/assets/web/pdf_render_worker.dart.js.deps

# Compiled worker served by the browser integration test (never published).
packages/dart_pdf_editor/lib/src/sparse_test_worker.js
packages/dart_pdf_editor/lib/src/sparse_test_worker.js.map
packages/dart_pdf_editor/lib/src/sparse_test_worker.js.deps

# Generated workers used by the standalone performance harness. The harness
# build compiles these beside its source index before copying the complete web
# bundle to app/build/web; running the builder from the workspace root can also
# leave the same outputs under /web.
app/tool/perf_harness/web/pdf_render_worker.dart.js
app/tool/perf_harness/web/pdf_render_worker.dart.js.map
app/tool/perf_harness/web/pdf_render_worker.dart.js.deps
/web/pdf_render_worker.dart.js
/web/pdf_render_worker.dart.js.map
/web/pdf_render_worker.dart.js.deps

# generated by flutter pub get for plugin-using packages
.flutter-plugins-dependencies
.DS_Store

# Patrol generates bundled entrypoints and Playwright reports for E2E runs.
**/patrol_test/test_bundle.dart
packages/dart_pdf_editor/example/test_bundle.dart
**/playwright-report/
**/test-results/
.patrol.env
# Xcode duplicates the outer workspace's SwiftPM lock while resolving the
# generated Flutter package; the committed Runner.xcworkspace lock is canonical.
packages/dart_pdf_editor/example/*/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# generated by Firebase Hosting
site/.firebase/hosting..cache

# perf tooling artifacts (tool/perf.sh)
tool/perf/history/
tool/perf/cache/

# Store screenshots. The standalone-app marketing tree (doc/marketing/app/,
# English + localized) IS tracked so AppStream metainfo can reference stable
# raw-URL screenshots. The example/SDK showcase localized subdirs and the
# staged store copies are regenerable (screenshots.sh compose from the tracked
# raw captures + captions), so they stay out.
doc/marketing/example/*/*/
app/fastlane/metadata/*/*/images/
# Generated signed Flatpak repository; GitHub Actions deploys it directly.
flatpak-hosting/public/
