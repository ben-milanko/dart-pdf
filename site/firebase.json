{
  "hosting": {
    "site": "dartpdf",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "README.md", "i18n/_validate.py"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/sdk",
        "destination": "/flutter-pdf-editor",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/flutter-pdf-editor",
        "destination": "/sdk.html"
      }
    ],
    "headers": [
      {
        "source": "assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
